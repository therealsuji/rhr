<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Launching the app under test and opening links on the agent's behalf. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:allowBackup="false">

        <!-- Opened once after install: Android only binds an accessibility
             service of an app that has been launched, and this is where the
             tester is walked to the setting. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <service
            android:name=".AgentService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/rhr_agent_service"/>
        </service>

        <!-- The player asks for a device-control connection here. Exported so
             another app can reach it; AgentProvider only answers callers
             signed with this app's own key. -->
        <provider
            android:name=".AgentProvider"
            android:authorities="dev.rhr.agent.control"
            android:exported="true"/>
    </application>
</manifest>

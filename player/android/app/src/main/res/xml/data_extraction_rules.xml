<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: neither cloud backup nor device-to-device transfer may copy
     anything. allowBackup="false" alone still lets a D2D transfer through.

     The player keeps nothing a tester would miss: a session code, caches, and
     the installation identity, whose secret must stay on this phone (a copy
     restored elsewhere would let a second phone act as this one). Excluding
     every domain is simpler than keeping a list of the sensitive files in
     step with the code. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>

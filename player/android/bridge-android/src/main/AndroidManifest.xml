<?xml version="1.0" encoding="utf-8"?>
<!-- Library manifest: merged into host apps. Brings the session service and
     the permissions it needs; the host adds nothing by hand. Sessions are
     driven explicitly by the host (the player's lobby, the connector's
     picker), never started behind the user's back. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application>
        <!-- Native session service: the tunnel bridge must live outside the
             Dart world so hot restarts can't kill it. -->
        <service
            android:name="dev.rhr.rhr_player.RhrSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- Not dataSync: Android 15 stops dataSync services after 6 hours,
                 and a tester's session can run all day. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Developer tooling: carries a debug session between
                    the developer's computer and an app on this phone" />
        </service>
    </application>
</manifest>

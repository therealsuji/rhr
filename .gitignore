# Dart / Flutter
.dart_tool/
.packages
# Apps (cli, relay, player) commit pubspec.lock; libraries don't.
/bridge/pubspec.lock
/third_party/**/pubspec.lock
build/
player/release/
.flutter-plugins
.flutter-plugins-dependencies
.fvm/

# Kotlin / Gradle build caches
**/.kotlin/

# Node / Cloudflare Workers
node_modules/
.wrangler/

# Android signing — NEVER commit these
**/key.properties
*.jks
*.keystore
**/android/local.properties

# rhr CLI local state
.rhr.yaml
*.pid

# Local working notes
notes/

# Misc
.DS_Store
*.log

# opencode-goal-plugin persisted state (may contain goal text/checkpoints)
.opencode/goals/

# wrangler dev secrets
.dev.vars
